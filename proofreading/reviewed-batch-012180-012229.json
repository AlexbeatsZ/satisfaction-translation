  "format": "compact-v1",
  "entries": [
    {
      "index": 12181,
      "new_target": "她主动让自己染上污秽，被这鲜血弄脏了。"
    },
    {
      "index": 12184,
      "new_target": "「我是个笨蛋。又笨，又是个相当坏的孩子。」"
    },
    {
      "index": 12185,
      "new_target": "——已经无可挽回。"
    },
    {
      "index": 12187,
      "new_target": "诺艾尔抬起两人交叠的手。"
    },
    {
      "index": 12188,
      "new_target": "她被无法承受的强烈感情驱使，将那些手贴上自己的脸颊。"
    },
    {
      "index": 12192,
      "new_target": "她一边无声询问，一边紧紧依附上去。"
    },
    {
      "index": 12193,
      "new_target": "诺艾尔拼命攀住了理理。"
    },
    {
      "index": 12196,
      "new_target": "这双手正是她的救命绳和路标。"
    },
    {
      "index": 12197,
      "new_target": "理理的双手就是这样的存在。"
    },
    {
      "index": 12198,
      "new_target": "那双手如同脐带，将诺艾尔与世界相连。"
    },
    {
      "index": 12200,
      "new_target": "她无法放手。"
    },
    {
      "index": 12202,
      "new_target": "诺艾尔像小动物一样用脸颊蹭着她的手，呼吸幼稚地一颤一颤。"
    },
    {
      "index": 12206,
      "new_target": "她拼命地、忘我地将嘴唇和眼睑贴上那双手，像溺水者般紧紧依附着。"
    },
    {
      "index": 12208,
      "new_target": "「今天净是在哭。我也是，你也是。」"
    },
    {
      "index": 12212,
      "new_target": "她已经发不出任何声音。"
    },
    {
      "index": 12213,
      "new_target": "世上为什么会有这样的女孩？"
    },
    {
      "index": 12214,
      "new_target": "从第一次见面起，她就一直这样想。"
    },
    {
      "index": 12215,
      "new_target": "她只是走过，世界的色彩便仿佛鲜明地苏醒。"
    },
    {
      "index": 12216,
      "new_target": "她只是开口说话，世界的光便仿佛璀璨起来。"
    },
    {
      "index": 12218,
      "new_target": "这些都是理理给她的。"
    },
    {
      "index": 12219,
      "new_target": "理理仅仅存在于那里，就为诺艾尔带来了一个崭新的世界。"
    },
    {
      "index": 12220,
      "new_target": "「……啊哈……真是的，哭成这样，明天的脸肯定也很难看……根本没法见人……」"
    },
    {
      "index": 12221,
      "new_target": "理理终于发出一声真正的轻笑。"
    },
    {
      "index": 12222,
      "new_target": "仿佛与她重叠一般，诺艾尔唇边也落下一声轻笑。"
    },
    {
      "index": 12223,
      "new_target": "诺艾尔动了动身体，轻轻拉开理理环着她的手臂。"
    },
    {
      "index": 12225,
      "new_target": "诺艾尔从抱着自己的手臂中脱身，走到窗边。"
    },
    {
      "index": 12228,
      "new_target": "她吹灭了放在窗框上的蜡烛。"
    },
    {
      "index": 12229,
      "new_target": "接着，是床边的蜡烛。"
    }
  ]
}
