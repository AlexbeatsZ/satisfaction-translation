  "entries": [
    {"index": 7430, "new_target": "男人伸出的手臂轻而易举地缠住了她的腰身。", "status": "corrected", "note": "人工校对。"},
    {"index": 7431, "new_target": "回过神时，她已经被抛到了空中。", "status": "corrected", "note": "人工校对。"},
    {"index": 7432, "new_target": "天花板缓缓逼近眼前，视野翻转一周，接着是地板——", "status": "corrected", "note": "人工校对。"},
    {"index": 7433, "new_target": "她喘不过气来。", "status": "corrected", "note": "人工校对。"},
    {"index": 7434, "new_target": "她什么都弄不明白了。", "status": "corrected", "note": "人工校对。"},
    {"index": 7435, "new_target": "男人的嘴在动，可她听不清他说了什么。", "status": "corrected", "note": "人工校对。"},
    {"index": 7438, "new_target": "——要让、你、见识绝望？", "status": "corrected", "note": "人工校对。"},
    {"index": 7440, "new_target": "她的手臂被抓住，向前拉直。", "status": "corrected", "note": "人工校对。"},
    {"index": 7442, "new_target": "他们将她双手十指并拢——", "status": "corrected", "note": "人工校对。"},
    {"index": 7446, "new_target": "不要这个姿势。", "status": "corrected", "note": "人工校对。"},
    {"index": 7453, "new_target": "男人高高抬起脚——", "status": "corrected", "note": "人工校对。"},
    {"index": 7455, "new_target": "朝她并拢的手指踩了下去。", "status": "corrected", "note": "人工校对。"},
    {"index": 7458, "new_target": "——接下来是左手。", "status": "corrected", "note": "人工校对。"},
    {"index": 7460, "new_target": "——真可怜，都被踩得稀烂了。", "status": "corrected", "note": "人工校对。"},
    {"index": 7461, "new_target": "——别说钢琴，连一支铅笔都拿不起来了。", "status": "corrected", "note": "人工校对。"}
  ]
}
