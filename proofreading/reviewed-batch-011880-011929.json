  "entries": [
    {
      "index": 11880,
      "new_target": "欢快的语调。"
    },
    {
      "index": 11882,
      "new_target": "可与欢快的语调相反，理理仰望着她，睫毛正微微颤抖。"
    },
    {
      "index": 11884,
      "new_target": "仿佛迫切地渴望诺艾尔点头。"
    },
    {
      "index": 11887,
      "new_target": "理理的目光像是刺进诺艾尔的心脏，狠狠剜了一下。"
    },
    {
      "index": 11890,
      "new_target": "理理不知道，诺艾尔只是个毫无价值的残次品。"
    },
    {
      "index": 11892,
      "new_target": "这颗满是谎言的心没能承受住那道目光——痛得厉害。"
    },
    {
      "index": 11894,
      "new_target": "「……只要理理希望。我会一直戴着。」"
    },
    {
      "index": 11896,
      "new_target": "她用掌心接住递来的水晶碎片。"
    },
    {
      "index": 11897,
      "new_target": "轻轻地，生怕弄坏它。"
    },
    {
      "index": 11898,
      "new_target": "又牢牢地，生怕弄丢它。"
    },
    {
      "index": 11899,
      "new_target": "微光中，理理绽开了笑容。"
    },
    {
      "index": 11900,
      "new_target": "「好开心！我也会戴着！会一直戴着！我们是一样的……我和诺艾尔、雪野，戴着一样的项链！」"
    },
    {
      "index": 11901,
      "new_target": "笑容如花朵般在她小小的脸上盛开。接着，"
    },
    {
      "index": 11903,
      "new_target": "理理用指甲打开银链的搭扣，双手绕到颈后，灵巧地将项链戴在了自己身上。"
    },
    {
      "index": 11906,
      "new_target": "银链上小小的搭扣，怎么也勾不住指甲。"
    },
    {
      "index": 11907,
      "new_target": "要是改用古尔薇格的剑尖，肯定还更容易。"
    },
    {
      "index": 11909,
      "new_target": "刚刚打开一点的搭扣弹开她的指甲，又合了回去。"
    },
    {
      "index": 11911,
      "new_target": "「真拿你这个笨手笨脚的家伙没办法。我帮你戴，把它给我。」"
    },
    {
      "index": 11915,
      "new_target": "理理拨开她后颈的头发，手指冰凉，诺艾尔的后背微微绷紧。"
    },
    {
      "index": 11918,
      "new_target": "项链被戴到颈上。过了一会儿，"
    },
    {
      "index": 11920,
      "new_target": "她吐出一口不知何时屏住的气。"
    },
    {
      "index": 11922,
      "new_target": "她正要回过头，胸前的小小光芒随之摇曳。"
    },
    {
      "index": 11923,
      "new_target": "锁骨上传来一丝陌生的触感。"
    },
    {
      "index": 11925,
      "new_target": "她捏起水晶坠饰，托在掌心，对着烛光举起。"
    },
    {
      "index": 11926,
      "new_target": "火光透过水晶，胸前的星星一闪一闪地发亮。"
    },
    {
      "index": 11928,
      "new_target": "仿佛将数万光年外的遥远光辉，捉进了自己的掌心。"
    }
  ]
}
