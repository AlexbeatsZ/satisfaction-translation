  "entries": [
    {
      "index": 11833,
      "new_target": "「真的。」"
    },
    {
      "index": 11834,
      "new_target": "「还有……其实呢……呃……饭后还有一份幸运机会奖品。」"
    },
    {
      "index": 11837,
      "new_target": "她拿出一个小盒子。"
    },
    {
      "index": 11838,
      "new_target": "「……幸运机会是什么？」"
    },
    {
      "index": 11839,
      "new_target": "理理咧嘴一笑。"
    },
    {
      "index": 11840,
      "new_target": "「那只是随口一说，先放一边。呃……我们去咖啡馆那天，还去了饰品店，记得吗？」"
    },
    {
      "index": 11845,
      "new_target": "她从点头示意的理理手中，小心翼翼地接过盒子。"
    },
    {
      "index": 11847,
      "new_target": "白色盒子在烛光下泛着微光，上面系着一条青柠绿色的丝带。"
    },
    {
      "index": 11849,
      "new_target": "她既舍不得拆，又迫不及待想打开，心情十分复杂。她抬起眼，偷偷观察理理的表情。"
    },
    {
      "index": 11854,
      "new_target": "在理理笑着催促下，她用指甲尖轻轻解开了封住盒子的精致丝带。"
    },
    {
      "index": 11855,
      "new_target": "她小心地、小心地打开盒子，取去包装纸。"
    },
    {
      "index": 11859,
      "new_target": "烛光微微映照着三枚闪亮的碎片。"
    },
    {
      "index": 11861,
      "new_target": "盒中闪耀着三条细银链项链，每条都挂有水晶坠饰，并排摆放在一起。"
    },
    {
      "index": 11862,
      "new_target": "正如理理所说，银链下方的水晶形似从夜空繁星上坠落的一小片光。"
    },
    {
      "index": 11864,
      "new_target": "「……这些……是给我、的吗？可这里有三条……」"
    },
    {
      "index": 11872,
      "new_target": "似乎是因为得到了赞同，理理的笑容变得更加灿烂。"
    },
    {
      "index": 11873,
      "new_target": "这枚透明的水晶是她的星，是一颗在天空中闪耀着美丽光泽的星。"
    },
    {
      "index": 11878,
      "new_target": "淡淡的水蓝色中，映入其中的烛光缓缓摇曳。"
    },
    {
      "index": 11879,
      "new_target": "「这个颜色很适合诺艾尔。吊坠很小，戴在制服下面应该也不会显眼。你愿意戴着它吗？」"
    }
  ]
}
