{"range":{"start":6630,"end":6729},"reviewed_at":"2026-08-05","format":"compact-v1","entries":[{"index":6630,"new_target":"她蹬地冲出，瞬间缩短距离，闯入男人怀中。","status":"corrected","note":"人工校对。"},{"index":6631,"new_target":"莱金雷夫自下而上斜斜剜去——","status":"corrected","note":"人工校对。"},{"index":6632,"new_target":"「呃！」","status":"corrected","note":"人工校对。"},{"index":6633,"new_target":"男人勉强用手枪格开黑刃。诺艾尔嘴角带笑，像舞蹈般流畅旋身；转回正面时，右手古尔薇格已横切男人胸口。","status":"corrected","note":"人工校对。"},{"index":6635,"new_target":"飞溅的血花点缀着诺艾尔。","status":"corrected","note":"人工校对。"},{"index":6636,"new_target":"「……我不喜欢你的做法。」","status":"corrected","note":"人工校对。"},{"index":6638,"new_target":"她没有追击，主动拉开距离。右手古尔薇格、左手莱金雷夫，双刃交叠摆开架势。","status":"corrected","note":"人工校对。"},{"index":6639,"new_target":"「雪野也是你带走的？」","status":"corrected","note":"人工校对。"},{"index":6641,"new_target":"男人的眼神瞬间变了。","status":"corrected","note":"人工校对。"},{"index":6642,"new_target":"他动作熟练地撑起身，单膝跪地——","status":"corrected","note":"人工校对。"},{"index":6644,"new_target":"他敏捷地单手举枪开火。","status":"corrected","note":"人工校对。"},{"index":6645,"new_target":"弹道上已经没有诺艾尔的身影。","status":"corrected","note":"人工校对。"},{"index":6646,"new_target":"她把上身压到几乎贴地，从弹道下方滑过。","status":"corrected","note":"人工校对。"},{"index":6647,"new_target":"随即蹬上混凝土地面，以野兽般的姿态扑去。","status":"corrected","note":"人工校对。"},{"index":6648,"new_target":"她扫倒男人，反手握持的莱金雷夫柄尾深深撞进他腹部——","status":"corrected","note":"人工校对。"},{"index":6651,"new_target":"但她没有杀他。","status":"corrected","note":"人工校对。"},{"index":6652,"new_target":"至少现在还没有。","status":"corrected","note":"人工校对。"},{"index":6653,"new_target":"「说！」","status":"corrected","note":"人工校对。"},{"index":6654,"new_target":"「呃！」","status":"corrected","note":"人工校对。"},{"index":6655,"new_target":"回旋踢正中脸颊，男人横着飞了出去。","status":"corrected","note":"人工校对。"},{"index":6656,"new_target":"「是你掳走了雪野！？」","status":"corrected","note":"人工校对。"},{"index":6658,"new_target":"她跨坐在倒地男人腹部，将莱金雷夫刺进他的手掌。黑刃贯掌而过，把他钉在混凝土地面上。","status":"corrected","note":"人工校对。"},{"index":6660,"new_target":"「说。」","status":"corrected","note":"人工校对。"},{"index":6662,"new_target":"男人双眼发亮，挑衅地仰视诺艾尔。","status":"corrected","note":"人工校对。"},{"index":6663,"new_target":"诺艾尔踩住他的另一只手，夺下手枪，又漫不经心地把古尔薇格刺进他腹部。","status":"corrected","note":"人工校对。"},{"index":6665,"new_target":"「……你不会立刻死。但我伤到了你的主动脉。」","status":"corrected","note":"人工校对。"},{"index":6666,"new_target":"鲜血开始从薄刃周围涌出。","status":"corrected","note":"人工校对。"},{"index":6667,"new_target":"诺艾尔单手把夺来的手枪抵到男人鼻尖。","status":"corrected","note":"人工校对。"},{"index":6668,"new_target":"另一只手按上刺入他腹部的古尔薇格柄尾。","status":"corrected","note":"人工校对。"},{"index":6669,"new_target":"「我只要拔刀，或再把伤口切大，你就会失血而死。开枪更快。……回答我，是你掳走雪野的吗？」","status":"corrected","note":"人工校对。"},{"index":6671,"new_target":"男人摇了摇头，闭紧双眼片刻。","status":"corrected","note":"人工校对。"},{"index":6672,"new_target":"他舔过沾血的嘴唇，从咬紧的后槽牙间挤出嘶哑的声音。","status":"corrected","note":"人工校对。"},{"index":6673,"new_target":"「……雪……野……」","status":"corrected","note":"人工校对。"},{"index":6675,"new_target":"是不是下手太重了？","status":"corrected","note":"人工校对。"},{"index":6677,"new_target":"诺艾尔俯身，把耳朵凑到男人嘴边。","status":"corrected","note":"人工校对。"},{"index":6678,"new_target":"「……雪野……」","status":"corrected","note":"人工校对。"},{"index":6679,"new_target":"「听不清。说清楚。」","status":"corrected","note":"人工校对。"},{"index":6680,"new_target":"「——救救她。」","status":"corrected","note":"人工校对。"},{"index":6684,"new_target":"无论朝哪边看，都是黑暗冰冷的混凝土空间，她的方向感早已彻底麻痹。","status":"corrected","note":"人工校对。"},{"index":6686,"new_target":"浓烈的下水道臭味令人作呕。","status":"corrected","note":"人工校对。"},{"index":6688,"new_target":"黑暗、污秽、孤独——","status":"corrected","note":"人工校对。"},{"index":6689,"new_target":"她害怕极了。","status":"corrected","note":"人工校对。"},{"index":6691,"new_target":"每逢岔路她都迟疑不决，又被身后逼近的脚步声催得慌张钻进离她最近的通道。","status":"corrected","note":"人工校对。"},{"index":6694,"new_target":"脚在湿滑的地面上一滑，她重重摔倒。","status":"corrected","note":"人工校对。"},{"index":6696,"new_target":"为了护住腹部，她用脸承受了冲击。","status":"corrected","note":"人工校对。"},{"index":6698,"new_target":"疼得她一时喘不过气，眼泪涌了出来。","status":"corrected","note":"人工校对。"},{"index":6700,"new_target":"「……撑住……撑住……！怎么能在这种地方认输……！」","status":"corrected","note":"人工校对。"},{"index":6701,"new_target":"她猛地吐出不断积在口中的血沫。","status":"corrected","note":"人工校对。"},{"index":6704,"new_target":"不知道这是哪里，但这么暗，肯定是某栋建筑的地下。无论如何得先回到地面。","status":"corrected","note":"人工校对。"},{"index":6707,"new_target":"每跑一步，膝盖上撕裂敞开的伤口都痛得厉害。","status":"corrected","note":"人工校对。"},{"index":6709,"new_target":"当时若能逃掉就好了——可三个男人把她抬了起来，她根本无计可施。","status":"corrected","note":"人工校对。"},{"index":6711,"new_target":"老师们发现她没去上个人课，现在一定正拼命寻找她。","status":"corrected","note":"人工校对。"},{"index":6712,"new_target":"也许还有人目击了绑架。","status":"corrected","note":"人工校对。"},{"index":6714,"new_target":"只要抵达地面，她就能逃出去。","status":"corrected","note":"人工校对。"},{"index":6715,"new_target":"能得救。","status":"corrected","note":"人工校对。"},{"index":6720,"new_target":"雪野借着微弱的光继续奔跑。","status":"corrected","note":"人工校对。"},{"index":6722,"new_target":"这时——","status":"corrected","note":"人工校对。"},{"index":6726,"new_target":"她硬挤出笑容，纯粹是在逞强。即使脸部肌肉僵硬，也仍笑着像小动物般环顾四周。","status":"corrected","note":"人工校对。"},{"index":6727,"new_target":"——这里似乎有些眼熟。","status":"corrected","note":"人工校对。"},{"index":6728,"new_target":"她可能已经反复经过同一个地方。","status":"corrected","note":"人工校对。"}]}
