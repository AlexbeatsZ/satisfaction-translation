  "entries": [
    {
      "index": 11982,
      "new_target": "「……求你。现在……别回头……」"
    },
    {
      "index": 11983,
      "new_target": "那声音仿佛浸在水里，含混不清——听起来绝不是在笑——"
    },
    {
      "index": 11986,
      "new_target": "只有背后传来的触感——理理温暖柔软的身体贴得更紧了。"
    },
    {
      "index": 11987,
      "new_target": "理理从背后抱住了她。"
    },
    {
      "index": 11988,
      "new_target": "纤细的手臂隔着睡裙环上她的腰。"
    },
    {
      "index": 11992,
      "new_target": "「……不要回头……只要一会儿、就好……」"
    },
    {
      "index": 11996,
      "new_target": "颤抖而沙哑的声音。"
    },
    {
      "index": 11998,
      "new_target": "理理正咬紧声音，悄悄哭泣。"
    },
    {
      "index": 12002,
      "new_target": "理理环在她腰间的手剧烈颤抖，死死攥住诺艾尔的衬衫。"
    },
    {
      "index": 12003,
      "new_target": "诺艾尔想握住那只手。"
    },
    {
      "index": 12004,
      "new_target": "必须替她暖一暖。她这样想。"
    },
    {
      "index": 12009,
      "new_target": "并不是从没握过理理的手。过去已经握过许多次。"
    },
    {
      "index": 12014,
      "new_target": "她摊开自己的双手。"
    },
    {
      "index": 12015,
      "new_target": "骨节分明的五指、薄薄的手掌、一道横过掌心的伤疤——黏稠的鲜血缠覆其上，几乎将一切遮住。"
    },
    {
      "index": 12016,
      "new_target": "这双手果然沾满了血。"
    },
    {
      "index": 12017,
      "new_target": "她杀过多少生命，双手便沾着多少鲜血。诺艾尔的手肮脏得仿佛随时都会腐烂脱落。"
    },
    {
      "index": 12018,
      "new_target": "她甚至不明白，自己为何直到现在才发现这份污秽。"
    },
    {
      "index": 12019,
      "new_target": "也不明白，自己过去为何能若无其事地触碰理理。"
    },
    {
      "index": 12021,
      "new_target": "浸透罪孽的肮脏双手。"
    },
    {
      "index": 12022,
      "new_target": "她根本不可能伸手触碰。"
    },
    {
      "index": 12023,
      "new_target": "她不能用这样的手碰理理洁白的双手，不能让这鲜血弄脏她。"
    },
    {
      "index": 12024,
      "new_target": "她无法伸手，只能攥紧拳头。拳头渐渐失去血色，变得冰冷。"
    },
    {
      "index": 12027,
      "new_target": "声音里带着吸鼻子的抽噎，像是勉强挤出来的。"
    }
  ]
}
