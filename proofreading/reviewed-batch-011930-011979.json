  "entries": [
    {
      "index": 11930,
      "new_target": "她不由得发出一声轻叹。"
    },
    {
      "index": 11937,
      "new_target": "贴在她背上的，大概是理理的脸颊。"
    },
    {
      "index": 11938,
      "new_target": "这样一来，自己的心跳和呼吸声岂不是全会被她听见。"
    },
    {
      "index": 11941,
      "new_target": "这样简直像是在紧张——念头刚一闪过，身体便绷得更紧了——太蠢了。自己究竟在做什么。"
    },
    {
      "index": 11943,
      "new_target": "声音里带着浅浅的笑意。"
    },
    {
      "index": 11946,
      "new_target": "她果然还是发现了。"
    },
    {
      "index": 11948,
      "new_target": "「这份礼物……你喜欢吗？」"
    },
    {
      "index": 11952,
      "new_target": "「……真的、真的喜欢？」"
    },
    {
      "index": 11953,
      "new_target": "同一句傻话被反复追问。"
    },
    {
      "index": 11954,
      "new_target": "诺艾尔叹了口气，随后露出一丝微笑。"
    },
    {
      "index": 11957,
      "new_target": "迟迟没有回应，诺艾尔有些不安。"
    },
    {
      "index": 11958,
      "new_target": "难道自己说了什么奇怪的话吗？"
    },
    {
      "index": 11962,
      "new_target": "换作理理，确实很有可能。"
    },
    {
      "index": 11964,
      "new_target": "「没事……我还醒着。」"
    },
    {
      "index": 11967,
      "new_target": "「……想事情？在想吃的吗？刚才的蛋糕？还是明天的早餐？」"
    },
    {
      "index": 11970,
      "new_target": "理理笑出声来，用小拳头轻轻捶了捶她的肩头。"
    },
    {
      "index": 11971,
      "new_target": "「不是啦……我只是觉得……好小啊……」"
    },
    {
      "index": 11973,
      "new_target": "「——你的背，好小啊……」"
    },
    {
      "index": 11974,
      "new_target": "她的呼吸猛地一颤。"
    },
    {
      "index": 11975,
      "new_target": "那声音忽然变得沙哑。"
    },
    {
      "index": 11976,
      "new_target": "几乎听不清了。"
    }
  ]
}
