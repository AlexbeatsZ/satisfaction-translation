  "entries": [
    {"index": 7595, "new_target": "「好，准备好了。把她扔出去。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7596, "new_target": "「……？」", "status": "corrected", "note": "人工校对。"},
    {"index": 7606, "new_target": "「小心点。预备——」", "status": "corrected", "note": "人工校对。"},
    {"index": 7608, "new_target": "她被从座椅上抬了起来。", "status": "corrected", "note": "人工校对。"},
    {"index": 7609, "new_target": "那具失去意识、仍在抽搐的身体被扔到柏油路上。", "status": "corrected", "note": "人工校对。"},
    {"index": 7610, "new_target": "重重摔落。", "status": "corrected", "note": "人工校对。"},
    {"index": 7611, "new_target": "又高高弹起一次。", "status": "corrected", "note": "人工校对。"},
    {"index": 7612, "new_target": "滚了出去。", "status": "corrected", "note": "人工校对。"},
    {"index": 7613, "new_target": "最后停在道路正中央。", "status": "corrected", "note": "人工校对。"},
    {"index": 7614, "new_target": "车在前方不远处急刹停下。", "status": "corrected", "note": "人工校对。"},
    {"index": 7615, "new_target": "轮胎尖叫着，车辆掉头。", "status": "corrected", "note": "人工校对。"},
    {"index": 7616, "new_target": "为确保万无一失。", "status": "corrected", "note": "人工校对。"},
    {"index": 7617, "new_target": "引擎轰鸣起来。", "status": "corrected", "note": "人工校对。"},
    {"index": 7618, "new_target": "车辆再次冲了出去。", "status": "corrected", "note": "人工校对。"},
    {"index": 7619, "new_target": "「天气真好。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7620, "new_target": "「是我最喜欢的天空颜色。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7621, "new_target": "「可我不知为什么，觉得好寂寞。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7622, "new_target": "「不……一直以来，我都很寂寞。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7623, "new_target": "「天空越蓝、越美，我就越不安。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7624, "new_target": "「我害怕一切都会毁掉。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7625, "new_target": "「可我大概……其实一直在等待。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7626, "new_target": "「等报应降临。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7627, "new_target": "「等着有人来责备我。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7628, "new_target": "「等着这一切毁掉。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7629, "new_target": "「因为这种事本来就不可能被允许。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7631, "new_target": "「我什么也没能守住。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7633, "new_target": "她什么也没能守住。", "status": "corrected", "note": "人工校对。"},
    {"index": 7634, "new_target": "珍视的一切，全都毁坏、消失了。", "status": "corrected", "note": "人工校对。"},
    {"index": 7636, "new_target": "没有一样能再回来。", "status": "corrected", "note": "人工校对。"},
    {"index": 7637, "new_target": "「可是……可是啊，我——」", "status": "corrected", "note": "人工校对。"},
    {"index": 7642, "new_target": "还有本该出生的孩子，", "status": "corrected", "note": "人工校对。"},
    {"index": 7644, "new_target": "「——你愿意和我做朋友吗？……我想和你做朋友。」", "status": "corrected", "note": "人工校对。"},
    {"index": 7647, "new_target": "虽然全都失去了，可我确实曾经拥有过。", "status": "corrected", "note": "人工校对。"},
    {"index": 7648, "new_target": "恋人、家人，还有朋友——", "status": "corrected", "note": "人工校对。"},
    {"index": 7649, "new_target": "四只车轮依次将她的身体卷了进去。", "status": "corrected", "note": "人工校对。"},
    {"index": 7650, "new_target": "柔软的身体轻易撕裂，碎块飞散四周。", "status": "corrected", "note": "人工校对。"},
    {"index": 7651, "new_target": "车辆驶过后再次倒回，轮胎又一次从那些碎块上碾过。", "status": "corrected", "note": "人工校对。"},
    {"index": 7652, "new_target": "这样的碾压持续了片刻，痛苦终于结束。", "status": "corrected", "note": "人工校对。"},
    {"index": 7653, "new_target": "名为寂静的救赎终于降临到她身上。", "status": "corrected", "note": "人工校对。"},
    {"index": 7654, "new_target": "随后，宁静的午后过去。", "status": "corrected", "note": "人工校对。"},
    {"index": 7655, "new_target": "黄昏骤然转冷，染成靛蓝。", "status": "corrected", "note": "人工校对。"},
    {"index": 7656, "new_target": "雨无声地落下。", "status": "corrected", "note": "人工校对。"},
    {"index": 7657, "new_target": "冰冷的夜色掩盖了一切。", "status": "corrected", "note": "人工校对。"},
    {"index": 7658, "new_target": "过了很久，她终于被人发现。", "status": "corrected", "note": "人工校对。"},
    {"index": 7659, "new_target": "她被装进一个小小的塑料袋，回到了温暖的屋檐下。", "status": "corrected", "note": "人工校对。"},
    {"index": 7660, "new_target": "可她大部分的身体早已被雨水冲走。", "status": "corrected", "note": "人工校对。"},
    {"index": 7661, "new_target": "她的身体只剩下零星碎片。", "status": "corrected", "note": "人工校对。"},
    {"index": 7662, "new_target": "已经过了晚上九点。", "status": "corrected", "note": "人工校对。"},
    {"index": 7665, "new_target": "她站起身梳理头发，勉强让自己平静下来。深呼吸三次后，手指终于不再发抖。", "status": "corrected", "note": "人工校对。"},
    {"index": 7667, "new_target": "她下定决心，握住门把手正要开门。", "status": "corrected", "note": "人工校对。"},
    {"index": 7671, "new_target": "房门比她动手早一瞬打开了。", "status": "corrected", "note": "人工校对。"},
    {"index": 7672, "new_target": "贵子站在门外。", "status": "corrected", "note": "人工校对。"},
    {"index": 7673, "new_target": "理理看到眼前贵子的装束，惊讶地睁大眼睛。", "status": "corrected", "note": "人工校对。"},
    {"index": 7674, "new_target": "她穿着礼装。", "status": "corrected", "note": "人工校对。"},
    {"index": 7675, "new_target": "那是按规定只有典礼时才能穿的特殊服装。", "status": "corrected", "note": "人工校对。"},
    {"index": 7676, "new_target": "「贵子姐姐……您、怎么了……」", "status": "corrected", "note": "人工校对。"},
    {"index": 7677, "new_target": "「我有急事。倒是你怎么了？外出时间早就过了。这么晚要去哪里？」", "status": "corrected", "note": "人工校对。"},
    {"index": 7679, "new_target": "理理不知道该从何说起，只能支支吾吾地低下头。", "status": "corrected", "note": "人工校对。"},
    {"index": 7680, "new_target": "她本来打算出去找人。", "status": "corrected", "note": "人工校对。"},
    {"index": 7682, "new_target": "自那以后便再没有任何消息。", "status": "corrected", "note": "人工校对。"},
    {"index": 7683, "new_target": "然后是诺艾尔。", "status": "corrected", "note": "人工校对。"},
    {"index": 7684, "new_target": "自从在洗手间分别后，诺艾尔也不见了。", "status": "corrected", "note": "人工校对。"},
    {"index": 7685, "new_target": "那之后，理理根本无法继续躺在保健室里，很快便回到了教室。", "status": "corrected", "note": "人工校对。"},
    {"index": 7686, "new_target": "可诺艾尔到处都找不到。", "status": "corrected", "note": "人工校对。"},
    {"index": 7687, "new_target": "直到上课时间，她也没有出现。", "status": "corrected", "note": "人工校对。"},
    {"index": 7688, "new_target": "理理原本打算等老师来了，就告诉老师诺艾尔不见了。", "status": "corrected", "note": "人工校对。"},
    {"index": 7689, "new_target": "可老师迟迟没有出现。", "status": "corrected", "note": "人工校对。"},
    {"index": 7690, "new_target": "随后，广播突然宣布停课。", "status": "corrected", "note": "人工校对。"},
    {"index": 7691, "new_target": "所有学生都被送回宿舍。", "status": "corrected", "note": "人工校对。"},
    {"index": 7692, "new_target": "接着又安排了一场用来打发时间的特别讲习——学生们被要求用一本题为《社会福利与税制》的老旧教材自习，并在下午五点前提交十KB的报告。", "status": "corrected", "note": "人工校对。"},
    {"index": 7693, "new_target": "即使交完报告也不准回房间，所有学生被直接集合到食堂。", "status": "corrected", "note": "人工校对。"},
    {"index": 7694, "new_target": "首先进行的是回收委员会上一年度的成果报告。", "status": "corrected", "note": "人工校对。"}
  ]
}
