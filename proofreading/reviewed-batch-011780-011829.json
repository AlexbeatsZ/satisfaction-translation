  "entries": [
    {
      "index": 11781,
      "new_target": "果然，贪吃鬼的功力就是不同。虽说同样只咬了一口，分量看起来却足有诺艾尔的两倍。"
    },
    {
      "index": 11784,
      "new_target": "她鼓着腮帮子笑，鼻尖和脸颊都沾满奶油，和诺艾尔一样狼狈。"
    },
    {
      "index": 11788,
      "new_target": "可怜的草莓从被咬出的蛋糕断崖上滚落下来。要是掉到床单上，就等着听洗衣女工念叨吧。"
    },
    {
      "index": 11790,
      "new_target": "「呜呀！」"
    },
    {
      "index": 11793,
      "new_target": "就在它即将掉上床单、酿成惨剧的前一刻——落进了诺艾尔手中。"
    },
    {
      "index": 11795,
      "new_target": "「诺艾尔，接得漂亮！」"
    },
    {
      "index": 11796,
      "new_target": "理理笑了起来，可救下蛋糕的诺艾尔却弄得满手奶油，黏糊糊的。"
    },
    {
      "index": 11797,
      "new_target": "「呜哇……这哪里算接得漂亮啊……」"
    },
    {
      "index": 11801,
      "new_target": "柔软的舌头挠得指缝发痒，诺艾尔扭动起身子。"
    },
    {
      "index": 11802,
      "new_target": "「找到巧克力了！」"
    },
    {
      "index": 11804,
      "new_target": "诺艾尔受不了牙齿轻咬带来的痒意，叫着想躲开。这一动，奶油又从唇角溢了出来，衬衫也脏了，床单也脏了，场面简直糟透了。"
    },
    {
      "index": 11806,
      "new_target": "「啊——，真不敢相信。诺艾尔，你把这里那颗心形糖果吃掉了！？」"
    },
    {
      "index": 11807,
      "new_target": "「这是我的欢迎派对吧？当然要优先让我吃想吃的地方。」"
    },
    {
      "index": 11808,
      "new_target": "「人家还觉得可爱，想留下来当装饰呢！」"
    },
    {
      "index": 11809,
      "new_target": "「会招虫子的。啊，我也找到巧克力了……啊呜。」"
    },
    {
      "index": 11810,
      "new_target": "「啊——！那里是我看中的！」"
    },
    {
      "index": 11812,
      "new_target": "在理理用烛光营造出的温暖小宇宙里。"
    },
    {
      "index": 11813,
      "new_target": "在这片如同秘密藏身处的星光之中。"
    },
    {
      "index": 11814,
      "new_target": "喧闹的笑声和甜蜜的香气，无比温柔。"
    },
    {
      "index": 11815,
      "new_target": "两人笑得东倒西歪，彼此嬉闹，额头撞在一起，轮流大口吃着蛋糕。"
    },
    {
      "index": 11819,
      "new_target": "她们争着张大嘴巴，诺艾尔和理理就像两只分食饵料的雏鸟。"
    },
    {
      "index": 11821,
      "new_target": "理理擦去笑出来的泪水，轻声低语。"
    },
    {
      "index": 11823,
      "new_target": "她用指尖捏起一小块蛋糕，蘸起盘中残留的奶油，送进嘴里。"
    },
    {
      "index": 11827,
      "new_target": "沉默持续了三次深呼吸那么久。"
    },
    {
      "index": 11828,
      "new_target": "笑声的余韵尚在，两人相望的眼眸却异常平静。"
    }
  ]
}
